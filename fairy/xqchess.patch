 /// evaluate() is the evaluator for the outer world. It returns a static
 /// evaluation of the position from the point of view of the side to move.
 
+/// xq_evaluate() is the evaluation of the xqchess variant (a Western chess army against a
+/// Xiangqi army on 8x8), with weights fitted to self-play results.  It mirrors evaluate() in
+/// the xqchess engine (engine/xqchess.cpp and pyengine.py) term by term and returns centipawns
+/// from the side to move's point of view.
+
+namespace {
+
+  inline int xq_center(Square s) {
+      int f = file_of(s), r = rank_of(s);
+      return std::min(f, 7 - f) + std::min(r, 7 - r);            // 0 in a corner .. 6 in the centre
+  }
+
+  // The xqchess engine's number for a role letter (the order of its piece letters .PNBRQKSHEAJCG)
+  inline int xq_type(char role) {
+      const char* p = role ? std::strchr(".pnbrqksheajcg", role) : nullptr;
+      return p ? int(p - ".pnbrqksheajcg") : 0;
+  }
+
+  // At most two piece types as one number, hi * 16 + lo (0 = none)
+  inline int xq_eg_code(const int* t, int n) {
+      return n == 0 ? 0 : n == 1 ? t[0] * 16 : std::max(t[0], t[1]) * 16 + std::min(t[0], t[1]);
+  }
+
+  // Mating technique for side a: drive the other royal to the edge and into a corner, and come close
+  inline int xq_mopup(const Position& pos, Color a, const Variant* v) {
+      Square d = pos.square<KING>(~a), k = pos.square<KING>(a);
+      int dist = std::abs(file_of(d) - file_of(k)) + std::abs(rank_of(d) - rank_of(k));
+      return v->xqMopupEdge * (7 - xq_center(d)) + v->xqMopupClose * (14 - dist);
+  }
+
+  // Known result of a king-against-general ending, in centipawns for the general's side g (see
+  // endgame_known() in pyengine.py): a bare general always loses; with at most two other pieces
+  // the result comes from the solved table xqEndgame.
+  bool xq_endgame_known(const Position& pos, Color g, const int types[COLOR_NB][2], const int* ntypes,
+                        const int* mat, int prr, const Variant* v, int& out) {
+      Color k = ~g;
+      if (!ntypes[g])
+      {
+          out = -(v->xqTbWin + mat[k] / 4 + xq_mopup(pos, k, v));
+          return true;
+      }
+      if (ntypes[g] + ntypes[k] > 2)
+          return false;
+      const int key = 65536 * prr + 256 * xq_eg_code(types[g], ntypes[g]) + xq_eg_code(types[k], ntypes[k]);
+      auto it = std::lower_bound(v->xqEndgame.begin(), v->xqEndgame.end(), std::make_pair(key, INT_MIN));
+      if (it == v->xqEndgame.end() || it->first != key)
+          return false;
+      const int val = it->second;
+      out = val + (mat[g] - mat[k]) * std::abs(val) / (8 * v->xqTbWin) + xq_mopup(pos, val > 0 ? g : k, v) * val / v->xqTbWin;
+      return true;
+  }
+
+  // Can a side with these counts (indexed by role letter) force mate against a bare royal?
+  inline bool xq_can_mate_bare(const int* cnt, bool general, const Variant* v) {
+      if (!general)
+      {
+          for (int ch = 'a'; ch <= 'z'; ++ch)
+              if (ch != 'k' && cnt[ch])
+                  return true;
+          return false;
+      }
+      if (cnt['q'])
+          return true;
+      int j = cnt['j'] + cnt['r'], ch = cnt['c'] + cnt['h'] + cnt['n'] + cnt['b'];
+      if (j >= 2 || (j >= 1 && ch >= 1))
+          return true;
+      return cnt['s'] && v->xqSoldierPromotion;
+  }
+
+} // namespace
+
+int Eval::xq_evaluate(const Position& pos) {
+
+  const Variant* v = pos.variant();
+  int sc[COLOR_NB] = {0, 0}, nonpawn = 0, bishops[COLOR_NB] = {0, 0}, cnt[COLOR_NB][128] = {};
+  int pieceMat[COLOR_NB] = {0, 0}, pawns[COLOR_NB] = {0, 0}, nonroyal[COLOR_NB] = {0, 0}, egAdj[COLOR_NB] = {0, 0};
+  int types[COLOR_NB][2] = {{0, 0}, {0, 0}}, mat[COLOR_NB] = {0, 0}, prr = 0;
+  const Bitboard occupied = pos.pieces();
+
+  for (Bitboard b = occupied; b; )
+  {
+      Square s = pop_lsb(b);
+      Piece pc = pos.piece_on(s);
+      Color c = color_of(pc);
+      PieceType pt = type_of(pc);
+      char role = v->xqRole[pt];
+      cnt[c][int(role)]++;
+      sc[c] += v->xqValue[pt];
+      egAdj[c] += v->xqValueEg[pt];
+      if (pos.sniper_types(c) & pt)       // a sniper is worth more than an ordinary piece
+      {
+          sc[c] += v->xqSniperMg;
+          egAdj[c] += v->xqSniperEg;
+      }
+      if (pt == KING)
+          continue;
+      if (nonroyal[c] < 2)
+          types[c][nonroyal[c]] = xq_type(role);
+      nonroyal[c]++;
+      mat[c] += v->xqValue[pt];
+      if (role == 'p' || role == 's')
+      {
+          pawns[c]++;
+          prr = c == WHITE ? int(rank_of(s)) : 7 - int(rank_of(s));
+      }
+      else
+      {
+          nonpawn += v->xqValue[pt];
+          pieceMat[c] += v->xqValue[pt];
+      }
+      if (role == 'b')
+          bishops[c]++;
+  }
+  const bool general[COLOR_NB] = { pos.king_type(WHITE) != KING, pos.king_type(BLACK) != KING };
+
+  // a king against a general: the solved endings
+  if (general[WHITE] != general[BLACK] && pos.count<KING>(WHITE) && pos.count<KING>(BLACK))
+  {
+      Color g = general[WHITE] ? WHITE : BLACK;
+      int npw = pawns[WHITE] + pawns[BLACK], known;
+      if ((npw <= 1 || !nonroyal[g]) && xq_endgame_known(pos, g, types, nonroyal, mat, npw == 1 ? prr : 0, v, known))
+      {
+          int e = g == WHITE ? known : -known;
+          e = e * (v->xqFiftyDiv - std::min(pos.rule50_count(), 100)) / v->xqFiftyDiv;
+          return (pos.side_to_move() == WHITE ? e : -e) + v->xqTempo;
+      }
+  }
+
+  // bare king/general: either a dead draw, or drive it to the edge
+  int mop = 0;
+  for (Color c : {WHITE, BLACK})
+  {
+      if (nonroyal[~c] || !nonroyal[c] || !pos.count<KING>(c) || !pos.count<KING>(~c))
+          continue;
+      if (!xq_can_mate_bare(cnt[c], general[c], v))
+          return 0;
+      int bonus = xq_mopup(pos, c, v);
+      mop += c == WHITE ? bonus : -bonus;
+  }
+  const int mg = std::min(nonpawn, 5000);
+  for (Color c : {WHITE, BLACK})
+      sc[c] += egAdj[c] * (5000 - mg) / 5000;
+
+  for (Bitboard b = occupied; b; )
+  {
+      Square s = pop_lsb(b);
+      Piece pc = pos.piece_on(s);
+      Color c = color_of(pc);
+      PieceType pt = type_of(pc);
+      char role = v->xqRole[pt];
+      int rr = c == WHITE ? int(rank_of(s)) : 7 - int(rank_of(s)), cen = xq_center(s);
+      int val = v->xqCentre[pt] * cen;
+      if (role == 'p')
+          val = v->xqPawnAdv[rr] + ((file_of(s) == FILE_D || file_of(s) == FILE_E) ? v->xqPawnCentre : 0);
+      else if (role == 's')
+          val = v->xqSoldierAdv[rr];
+      else if (role == 'r' || role == 'j')
+          val = rr == 6 ? v->xqSeventh : 0;
+      else if (pt == KING)
+      {
+          int open = popcount(attacks_bb<ROOK>(s, occupied) & ~occupied & pos.board_bb());
+          if (!general[c])
+              val = (mg * (-v->xqKingMg * rr) + (5000 - mg) * (v->xqKingEg * cen)) / 5000 - v->xqOpenK * open;
+          else
+              val = (mg * (v->xqGenBaseMg - v->xqGenMg * rr) + (5000 - mg) * (v->xqGenBaseEg + v->xqGenEg * cen)) / 5000
+                   - v->xqOpenG * open;
+      }
+      if (v->xqMobility[pt])
+      {
+          Bitboard m =  (pos.moves_from(c, pt, s) & ~occupied)
+                      | (pos.attacks_from(c, pt, s) & pos.pieces(~c));
+          val += v->xqMobility[pt] * popcount(m);
+      }
+      sc[c] += val;
+  }
+  for (Color c : {WHITE, BLACK})
+      if (bishops[c] >= 2)
+          sc[c] += v->xqBishopPair;
+
+  int e = sc[WHITE] - sc[BLACK] + mop;
+  // drawish endings: the stronger side has no pawns/soldiers and only a small edge in pieces,
+  // or it is the general's side without enough material to mate even a bare king
+  Color strong = e >= 0 ? WHITE : BLACK;
+  int scale = 128;
+  if (!pawns[strong] && !mop)
+  {
+      int rookValue = 0;
+      for (PieceType pt = PAWN; pt <= KING; ++pt)
+          if (v->xqRole[pt] == 'r')
+              rookValue = v->xqValue[pt];
+      if (pieceMat[strong] - pieceMat[~strong] < rookValue)
+          scale = v->xqScaleNoPawn;
+      if (general[strong] && !xq_can_mate_bare(cnt[strong], true, v))
+          scale = std::min(scale, v->xqScaleXq);
+  }
+  e = e * scale / 128;
+  e = e * (v->xqFiftyDiv - std::min(pos.rule50_count(), 100)) / v->xqFiftyDiv;   // no progress: drift towards a draw
+  return (pos.side_to_move() == WHITE ? e : -e) + v->xqTempo;
+}
